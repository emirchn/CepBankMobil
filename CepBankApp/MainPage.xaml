<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CepBankApp"
             xmlns:components="clr-namespace:CepBankApp.Components"
             x:Class="CepBankApp.MainPage"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#161D38}">

    <Grid SafeAreaEdges="None">
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                       BackgroundColor="Transparent"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
        <Grid x:Name="NativeStartup" SafeAreaEdges="None" BackgroundColor="#20245F" InputTransparent="True" ZIndex="1">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <Image x:Name="NativeStartupLogo" Source="startup_logo.svg" WidthRequest="126" HeightRequest="126" HorizontalOptions="Center" />
                <Label Text="CepBank" TextColor="#F4F7FF" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <ActivityIndicator IsRunning="True" Color="#C9E7FF" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
