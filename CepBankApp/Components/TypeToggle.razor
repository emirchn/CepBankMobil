<fieldset class="type-toggle">
    <legend>Tür</legend>
    <label class="type-choice @(Value == "Income" ? "selected" : "")">
        <input type="checkbox" checked="@(Value == "Income")" @onclick="SelectIncomeAsync" @onclick:preventDefault="true" />
        <span>Gelir</span>
    </label>
    <label class="type-choice @(Value == "Expense" ? "selected" : "")">
        <input type="checkbox" checked="@(Value == "Expense")" @onclick="SelectExpenseAsync" @onclick:preventDefault="true" />
        <span>Gider</span>
    </label>
</fieldset>

@code {
    [Parameter] public string Value { get; set; } = "Expense";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool AllowClear { get; set; }

    private Task SelectIncomeAsync() => ValueChanged.InvokeAsync(AllowClear && Value == "Income" ? "" : "Income");
    private Task SelectExpenseAsync() => ValueChanged.InvokeAsync(AllowClear && Value == "Expense" ? "" : "Expense");
}
