@inherits LayoutComponentBase
@using Microsoft.Maui.Storage
@inject IJSRuntime JS
@inject NavigationManager Navigation

<main>
    <article class="content">
        @Body
    </article>
    <nav class="bottom-nav" aria-label="Ana menü">
        <NavLink href="" Match="NavLinkMatch.All"><svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg><small>Özet</small></NavLink>
        <NavLink href="accounts"><svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 10h18M7 15h6"/></svg><small>Hesaplar</small></NavLink>
        <NavLink href="transaction" class="nav-add"><span class="nav-add-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><small>Yeni işlem</small></NavLink>
        <NavLink href="cards"><svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/></svg><small>Kartlar</small></NavLink>
        <NavLink href="settings"><svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 2h3l.6 2.3 1.7.7 2.1-1.2 2.1 2.1-1.2 2.1.7 1.7L22 10.5v3l-2.3.6-.7 1.7 1.2 2.1-2.1 2.1-2.1-1.2-1.7.7-.6 2.3h-3l-.6-2.3-1.7-.7-2.1 1.2-2.1-2.1 1.2-2.1-.7-1.7L2 13.5v-3l2.3-.6.7-1.7-1.2-2.1 2.1-2.1L8 5l1.7-.7z"/><circle cx="12" cy="12" r="3"/></svg><small>Ayarlar</small></NavLink>
    </nav>
</main>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("cepbankTheme.apply", Preferences.Default.Get("theme_mode", "device"));
            if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/') != "")
            {
                await CepBankApp.MainPage.CompleteStartupAsync();
            }
        }
    }
}
