@using CepBankApp.Models

<span class="bank-logo" role="img" aria-label="@Brand.Name">
    @if (string.IsNullOrEmpty(Brand.Code))
    {
        <span class="bank-logo-fallback" aria-hidden="true">₺</span>
    }
    else
    {
        <img src="@($"bank-logos/{Brand.Code}.svg")" alt="" aria-hidden="true" />
    }
</span>

@code {
    [Parameter] public string? Code { get; set; }
    private BankBrand Brand => BankBrand.Find(Code);
}
