@inject NavigationManager Navigation
@implements IDisposable

<Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private bool _ready;

    protected override void OnInitialized() => Services.WidgetNavigation.RouteRequested += OnRouteRequested;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _ready = true;
        NavigatePending();
    }

    private void OnRouteRequested()
    {
        if (_ready) _ = InvokeAsync(NavigatePending);
    }

    private void NavigatePending()
    {
        var route = Services.WidgetNavigation.TakePendingRoute();
        if (route is not null) Navigation.NavigateTo(route);
    }

    public void Dispose() => Services.WidgetNavigation.RouteRequested -= OnRouteRequested;
}
