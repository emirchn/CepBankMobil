@page "/cards"
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@using System.Globalization
@inject DatabaseService Database
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject WidgetSummaryService WidgetSummary

<div class="finance-page">
    <nav class="card-type-tabs" aria-label="Kart türü">
        <button type="button" class="@TabClass("credit")" aria-pressed="@(_tab == "credit")" @onclick="SelectCredit">Kredi</button>
        <button type="button" class="@TabClass("fuel")" aria-pressed="@(_tab == "fuel")" @onclick="SelectFuel">Yakıt</button>
        <button type="button" class="@TabClass("meal")" aria-pressed="@(_tab == "meal")" @onclick="SelectMeal">Yemek</button>
    </nav>
    @if (_tab == "credit")
    {
    <header class="finance-header card-list-header">
        <h1>Kredi Kartları</h1>
        <NavLink href="cards/new" class="header-action">+ Kart ekle</NavLink>
    </header>

    <section class="card-debt-banner">
        <span>TOPLAM GÜNCEL BORÇ</span>
        <strong>@FormatMoney(_cards.Sum(card => card.CurrentDebt))</strong>
        <small>@_cards.Count kart</small>
    </section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }

    @if (_cards.Count == 0)
    {
        <div class="empty-state"><strong>Henüz kart eklenmedi</strong><p>İlk kartını ekleyerek harcamalarını takip etmeye başla.</p><NavLink href="cards/new" class="inline-link">Kart ekle →</NavLink></div>
    }
    else
    {
        <div class="card-list">
            @foreach (var card in _cards)
            {
                <article class="card-list-item">
                    <div class="card-list-top">
                        <CardIcon Color="@card.IconColor" />
                        <div class="card-list-title">
                            <strong>@card.Name</strong>
                            @if (card.RevealSensitive && _privateDetails.TryGetValue(card.Id, out var details) && !string.IsNullOrWhiteSpace(details.Number))
                            {
                                <span class="card-full-number">@FormatCardNumber(details.Number)</span>
                                <small class="card-cvv-expiry">CVV @details.Cvv  ·  Son kullanım @card.ExpirationMonth.ToString("00")/@(card.ExpirationYear.ToString().Length >= 2 ? card.ExpirationYear.ToString()[^2..] : card.ExpirationYear.ToString("00"))</small>
                            }
                            else
                            {
                                <span>•••• @card.LastFourDigits</span>
                            }
                        </div>
                    </div>
                    <div class="card-balance-panel">
                        <div class="card-balance-primary"><span>Güncel borç</span><strong>@FormatMoney(card.CurrentDebt)</strong></div>
                        <div class="card-balance-grid">
                            <div><span>Mevcut dönem</span><strong>@FormatMoney(card.CurrentPeriodDebt)</strong></div>
                            <div><span>Ekstre borcu</span><strong>@FormatMoney(card.StatementDebt)</strong></div>
                            <div><span>Gelecek taksitler</span><strong>@FormatMoney(card.FutureInstallmentDebt)</strong></div>
                            @if (card.CreditLimit.HasValue)
                            {
                                <div><span>Kullanılabilir limit</span><strong>@FormatMoney(card.AvailableLimit ?? 0)</strong><small>Toplam limit @FormatMoney(card.CreditLimit.Value)</small></div>
                            }
                        </div>
                    </div>
                    <div class="card-period"><span>Hesap Kesim Günü</span><strong>Ayın @card.StatementDay. Günü</strong></div>
                    <div class="card-payment-date"><span>Son Ödeme Günü</span><strong>Ayın @card.PaymentDay. Günü</strong></div>
                    <div class="card-icon-actions" role="group" aria-label="@($"{card.Name} işlemleri")">
                        <NavLink href="@($"cards/edit/{card.Id}")" class="card-icon-action" title="Kartı düzenle" aria-label="Kartı düzenle"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11-4-4L4 16v4ZM13 7l4 4"/></svg></NavLink>
                        <NavLink href="@($"cards/{card.Id}/movements")" class="card-icon-action" title="Mevcut ay hareketleri" aria-label="Mevcut ay hareketleri"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 10h16M4 15h10M4 20h10M17 15l3 3-3 3"/></svg></NavLink>
                        <NavLink href="@($"cards/{card.Id}/installments")" class="card-icon-action" title="Taksitli işlemler" aria-label="Taksitli işlemler"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M8 15h3m4 0h2"/></svg></NavLink>
                        <button class="card-icon-action danger" type="button" title="Kart bakiyesini ve bağlı işlemleri sıfırla" aria-label="Kart bakiyesini ve bağlı işlemleri sıfırla" @onclick="() => _resetCardId = card.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5M12 8v5l3 2"/></svg></button>
                        <button class="card-icon-action danger" type="button" title="Kart işlemlerini sil" aria-label="Kart işlemlerini sil" @onclick="() => _resetCardId = card.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v6m4-6v6"/></svg></button>
                    </div>
                </article>
            }
        </div>
    }
    }
    else
    {
        <BenefitCardPanel Kind="@(_tab == "fuel" ? BenefitCardKind.Fuel : BenefitCardKind.Meal)" />
    }
    @if (_resetCardId is int resetId)
    {
        <div class="dialog-backdrop" @onclick="() => _resetCardId = null">
            <section class="choice-dialog" role="dialog" aria-modal="true" aria-label="Kart işlemlerini sil" @onclick:stopPropagation="true">
                <h2>Kart işlemlerini sil</h2>
                <p>Bu karta ait harcamalar, ödemeler, taksitler ve bağlı abonelikler silinecek. Kart bilgileri kalacak. Banka hesabından yapılmış kart ödemeleri hesap bakiyesine geri eklenecek.</p>
                <div class="recurring-delete-actions"><button type="button" class="danger-button" @onclick="() => ResetCardAsync(resetId)">Evet, işlemleri sil</button><button type="button" class="secondary-button" @onclick="() => _resetCardId = null">Vazgeç</button></div>
            </section>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    private string _tab = "credit";
    private List<CreditCard> _cards = new();
    private string _error = string.Empty;
    private Dictionary<int, CardPrivateDetails> _privateDetails = new();
    private int? _resetCardId;
    private bool _creditLoaded;

    protected override async Task OnParametersSetAsync()
    {
        _tab = TypeQuery is "fuel" or "meal" ? TypeQuery : "credit";
        if (_tab != "credit" || _creditLoaded) return;
        await Database.InitializeAsync();
        await ReloadAsync();
        _creditLoaded = true;
    }

    private string TabClass(string tab) => _tab == tab ? "card-type-tab active" : "card-type-tab";
    private void SelectCredit() => SelectTab("credit");
    private void SelectFuel() => SelectTab("fuel");
    private void SelectMeal() => SelectTab("meal");
    private void SelectTab(string tab)
    {
        _tab = tab;
        Navigation.NavigateTo($"cards?type={tab}");
    }

    private async Task ResetCardAsync(int cardId)
    {
        _resetCardId = null;
        try
        {
            await Database.ResetCreditCardAsync(cardId);
            await WidgetSummary.TryRefreshAsync();
            try { await NotificationService.ScheduleUpcomingPaymentsAsync(); } catch { }
            try { await NotificationService.ScheduleDailyBalanceAsync(); } catch { }
            await ReloadAsync();
        }
        catch (Exception ex) { _error = $"Kart sıfırlanamadı: {ex.Message}"; }
    }

    private async Task ReloadAsync()
    {
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
        _privateDetails.Clear();
        foreach (var card in _cards.Where(card => card.RevealSensitive))
        {
            try
            {
                var details = await CardDetailsStore.GetAsync(card.SecureDetailsKey);
                if (details is not null) _privateDetails[card.Id] = details;
            }
            catch { }
        }
    }

    private static string FormatMoney(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);

    private static string FormatCardNumber(string number)
    {
        var digits = new string(number.Where(char.IsDigit).ToArray());
        return string.Join(" ", Enumerable.Range(0, (digits.Length + 3) / 4)
            .Select(index => digits.Substring(index * 4, Math.Min(4, digits.Length - index * 4))));
    }

}
