@page "/cards"
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@using System.Globalization
@inject DatabaseService Database
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject WidgetSummaryService WidgetSummary

<div class="finance-page">
    <nav class="card-type-tabs" aria-label="Kart türü">
        <button type="button" class="@TabClass("credit")" aria-pressed="@(_tab == "credit")" @onclick="SelectCredit">Kredi</button>
        <button type="button" class="@TabClass("fuel")" aria-pressed="@(_tab == "fuel")" @onclick="SelectFuel">Yakıt</button>
        <button type="button" class="@TabClass("meal")" aria-pressed="@(_tab == "meal")" @onclick="SelectMeal">Yemek</button>
    </nav>
    @if (_tab == "credit")
    {
    <header class="finance-header card-list-header">
        <h1>Kredi Kartları</h1>
        <NavLink href="cards/new" class="header-action">+ Kart ekle</NavLink>
    </header>

    <section class="card-debt-banner">
        <span>TOPLAM GÜNCEL BORÇ</span>
        <strong>@FormatMoney(_cards.Sum(card => card.CurrentDebt))</strong>
        <small>@_cards.Count kart</small>
    </section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }

    @if (_cards.Count == 0)
    {
        <div class="empty-state"><strong>Henüz kart eklenmedi</strong><p>İlk kartını ekleyerek harcamalarını takip etmeye başla.</p><NavLink href="cards/new" class="inline-link">Kart ekle →</NavLink></div>
    }
    else
    {
        <div class="card-list">
            @foreach (var card in _cards)
            {
                <article class="card-list-item">
                    <div class="card-list-top">
                        <CardIcon Color="@card.IconColor" />
                        <div class="card-list-title">
                            <strong>@card.Name</strong>
                            @if (card.RevealSensitive && _privateDetails.TryGetValue(card.Id, out var details) && !string.IsNullOrWhiteSpace(details.Number))
                            {
                                <span class="card-full-number">@FormatCardNumber(details.Number)</span>
                                <small class="card-cvv-expiry">CVV @details.Cvv  ·  Son kullanım @card.ExpirationMonth.ToString("00")/@(card.ExpirationYear.ToString().Length >= 2 ? card.ExpirationYear.ToString()[^2..] : card.ExpirationYear.ToString("00"))</small>
                            }
                            else
                            {
                                <span>•••• @card.LastFourDigits</span>
                            }
                        </div>
                        <div class="card-list-actions">
                            <NavLink href="@($"cards/edit/{card.Id}")" class="section-link">Düzenle</NavLink>
                            <button class="delete-button" type="button" title="Kartı listeden kaldır" @onclick="() => ArchiveCardAsync(card)">Kaldır</button>
                        </div>
                    </div>
                    <div class="card-list-bottom">
                        <div><small>Güncel borç</small><strong>@FormatMoney(card.CurrentDebt)</strong></div>
                        <div><small>Ekstre borcu</small><strong>@FormatMoney(card.StatementDebt)</strong></div>
                        <div><small>Mevcut dönem borcu</small><strong>@FormatMoney(card.CurrentPeriodDebt)</strong></div>
                        @if (card.FutureInstallmentDebt > 0)
                        {
                            <div><small>Gelecek taksitler</small><strong>@FormatMoney(card.FutureInstallmentDebt)</strong></div>
                        }
                        @if (card.CreditLimit.HasValue)
                        {
                            <div><small>Limit</small><strong>@FormatMoney(card.CreditLimit.Value)</strong></div>
                            <div><small>Kullanılabilir limit</small><strong>@FormatMoney(card.AvailableLimit ?? 0)</strong></div>
                        }
                    </div>
                    <div class="card-period"><span>Hesap Kesim Günü</span><strong>Ayın @card.StatementDay. Günü</strong></div>
                    <div class="card-payment-date"><span>Son Ödeme Günü</span><strong>Ayın @card.PaymentDay. Günü</strong></div>
                    @if (_movements.TryGetValue(card.Id, out var movements) && movements.Count > 0)
                    {
                        <div class="card-recent-movements">
                            <strong>Mevcut dönem hareketleri</strong>
                            @foreach (var movement in movements)
                            {
                                <div class="card-movement-row"><span>@movement.Description<small>@movement.Date.ToString("dd.MM.yyyy")@(movement.InstallmentCount > 1 ? $" · {movement.InstallmentCount} taksit" : "")</small></span><strong class="@(movement.CardDebtChange < 0 ? "positive" : "negative")">@(movement.CardDebtChange < 0 ? "−" : "+")@FormatMoney(movement.Amount)</strong></div>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
    }
    else
    {
        <BenefitCardPanel Kind="@(_tab == "fuel" ? BenefitCardKind.Fuel : BenefitCardKind.Meal)" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    private string _tab = "credit";
    private List<CreditCard> _cards = new();
    private string _error = string.Empty;
    private Dictionary<int, CardPrivateDetails> _privateDetails = new();
    private Dictionary<int, List<FinancialTransaction>> _movements = new();
    private bool _creditLoaded;

    protected override async Task OnParametersSetAsync()
    {
        _tab = TypeQuery is "fuel" or "meal" ? TypeQuery : "credit";
        if (_tab != "credit" || _creditLoaded) return;
        await Database.InitializeAsync();
        await ReloadAsync();
        _creditLoaded = true;
    }

    private string TabClass(string tab) => _tab == tab ? "card-type-tab active" : "card-type-tab";
    private void SelectCredit() => SelectTab("credit");
    private void SelectFuel() => SelectTab("fuel");
    private void SelectMeal() => SelectTab("meal");
    private void SelectTab(string tab)
    {
        _tab = tab;
        Navigation.NavigateTo($"cards?type={tab}");
    }

    private async Task ArchiveCardAsync(CreditCard card)
    {
        await Database.ArchiveCreditCardAsync(card);
        await WidgetSummary.TryRefreshAsync();
        try { await NotificationService.ScheduleUpcomingPaymentsAsync(); }
        catch { }
        try { await NotificationService.ScheduleDailyBalanceAsync(); }
        catch { }
        try { CardDetailsStore.Remove(card.SecureDetailsKey); }
        catch { _error = "Kart listeden kaldırıldı, ancak güvenli bilgileri temizlenemedi. Tüm verileri sıfırlama işlemiyle temizleyebilirsin."; }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
        _movements.Clear();
        foreach (var card in _cards)
            _movements[card.Id] = await Database.GetCardTransactionsForCurrentPeriodAsync(card);
        _privateDetails.Clear();
        foreach (var card in _cards.Where(card => card.RevealSensitive))
        {
            try
            {
                var details = await CardDetailsStore.GetAsync(card.SecureDetailsKey);
                if (details is not null) _privateDetails[card.Id] = details;
            }
            catch { }
        }
    }

    private static string FormatMoney(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);

    private static string FormatCardNumber(string number)
    {
        var digits = new string(number.Where(char.IsDigit).ToArray());
        return string.Join(" ", Enumerable.Range(0, (digits.Length + 3) / 4)
            .Select(index => digits.Substring(index * 4, Math.Min(4, digits.Length - index * 4))));
    }

}
