@page "/transaction/standard/{CardId:int}"
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@using System.Globalization
@inject DatabaseService Database
@inject NavigationManager Navigation
@inject WidgetSummaryService WidgetSummary
@inject NotificationService NotificationService

<div class="finance-page">
    <header class="finance-header">
        <div><NavLink href="transaction" class="back-link">← Yeni işleme dön</NavLink><p class="eyebrow">KREDİ KARTI / İŞLEM</p><h1>Kredi Kartı İşlemi</h1><p class="header-subtitle">@(_card is null ? "Kart bulunamadı" : $"{_card.Name} •••• {_card.LastFourDigits}")</p></div>
    </header>
    @if (_card is null)
    {
        <div class="empty-state"><strong>Kart bulunamadı</strong><NavLink href="transaction" class="inline-link">Kart seç →</NavLink></div>
    }
    else
    {
        <section class="add-card">
            <div class="section-heading"><div><p class="section-kicker">İŞLEM DETAYLARI</p><h2>Bilgileri doldur</h2></div><span>Bu cihazda saklanır</span></div>
            @if (!IsPayment)
            {
                <div class="card-purchase-mode" role="group" aria-label="Harcama biçimi">
                    <button type="button" class="@(!_isInstallmentPurchase ? "selected" : "")" aria-pressed="@(!_isInstallmentPurchase)" @onclick="() => SetPurchaseMode(false)">Normal harcama</button>
                    <button type="button" class="@(_isInstallmentPurchase ? "selected" : "")" aria-pressed="@_isInstallmentPurchase" @onclick="() => SetPurchaseMode(true)">Taksitli alışveriş</button>
                </div>
            }
            <div class="form-grid">
                @if (!IsPayment)
                {
                    <label>Tarih<input type="date" min="@_card.LastStatementDate.ToString("yyyy-MM-dd")" max="@OpenPeriodLastDay.ToString("yyyy-MM-dd")" @bind="_date" /></label>
                }
                <label>@(IsPayment ? "Ödeme tutarı (TL)" : _isInstallmentPurchase ? "Tek taksit tutarı (TL)" : "Harcama tutarı (TL)")<input type="text" inputmode="decimal" @bind="_amountText" @bind:event="oninput" placeholder="0,00" /></label>
                @if (!IsPayment)
                {
                    <label>Açıklama<input type="text" @bind="_description" @bind:event="oninput" placeholder="Örn. Market" /></label>
                }
                <label>Kategori
                    <select @bind="_category">
                        <option>Kredi Kartı Ödemesi</option><option>Yemek</option><option>Market</option><option>Kıyafet</option>
                        <option>Ulaşım</option><option>Fatura</option><option>Sağlık</option><option>Eğlence</option>
                        <option>Ev &amp; Yaşam</option><option>Teknoloji</option><option>Hobi &amp; Oyuncak</option>
                        <option>Eğitim</option><option>Diğer</option>
                    </select>
                </label>
                @if (IsPayment)
                {
                    <label>Ödeme yapılacak banka hesabı
                        <select @bind="_accountIdValue">
                            <option value="">Hesap seç</option>
                            @foreach (var account in _accounts)
                            {
                                <option value="@account.Id">@account.Name - @Money(account.CurrentBalance)</option>
                            }
                        </select>
                    </label>
                }
                else if (_isInstallmentPurchase)
                {
                    <label>Taksit sayısı<input type="number" min="2" max="36" step="1" @bind="_installmentCount" /></label>
                }
            </div>
            @if (IsPayment)
            {
                <p class="field-hint">Ekstre borcu: <strong>@Money(_card.StatementDebt)</strong> · Mevcut dönem borcu: <strong>@Money(_card.CurrentPeriodDebt)</strong><br />En fazla ödenebilir tutar: <strong>@Money(PayableDebt)</strong></p>
                @if (Amount > 0 && SelectedAccount is not null && Amount > SelectedAccount.CurrentBalance)
                {
                    <p class="error-message" role="alert">Banka hesabı bakiyesi yetersiz.</p>
                }
                @if (Amount > PayableDebt)
                {
                    <p class="error-message" role="alert">Ödeme ödenebilir borcu aşamaz.</p>
                }
            }
            else
            {
                <p class="field-hint">@CardEffectHint()</p>
                @if (_isInstallmentPurchase && Amount > 0 && _installmentCount is >= 2 and <= 36 && Amount <= decimal.MaxValue / _installmentCount)
                {
                    <p class="field-hint">Toplam alışveriş: <strong>@Money(Amount * _installmentCount)</strong> · Bu dönem: <strong>@Money(Amount)</strong></p>
                }
            }
            @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <p class="error-message">@_errorMessage</p> }
            <button class="primary-button" type="button" disabled="@_saving" @onclick="AddTransactionAsync">@(_saving ? "Kaydediliyor…" : "İşlemi kaydet")</button>
        </section>
        <section class="transactions-section" aria-label="Son kredi kartı işlemleri">
            <div class="section-heading"><h2>Son işlemler</h2><span>@_recentTransactions.Count işlem</span></div>
            @if (_recentTransactions.Count == 0)
            {
                <div class="empty-state"><strong>Bu kartta henüz işlem yok</strong></div>
            }
            else
            {
                <div class="transaction-list">
                    @foreach (var transaction in _recentTransactions)
                    {
                        var isPayment = transaction.CardDebtChange < 0 || transaction.Category == "Kredi Kartı Ödemesi";
                        <article class="transaction-row" @key="transaction.Id">
                            <div class="transaction-icon @(isPayment ? "income" : "expense")">@(isPayment ? "↙" : "↗")</div>
                            <div class="transaction-details">
                                <strong>@transaction.Description</strong>
                                <span>@transaction.Category · @transaction.Date.ToString("dd.MM.yyyy")</span>
                                @if (transaction.InstallmentCount > 1)
                                {
                                    <span>@transaction.InstallmentCount taksit · Taksit başına @Money(transaction.CardPeriodChange)</span>
                                }
                            </div>
                            <div class="transaction-actions"><strong class="@(isPayment ? "positive" : "negative")">@(isPayment ? "+" : "−")@Money(transaction.Amount)</strong></div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int CardId { get; set; }
    private CreditCard? _card;
    private List<BankAccount> _accounts = new();
    private List<FinancialTransaction> _recentTransactions = new();
    private DateTime _date = DateTime.Today;
    private string _amountText = string.Empty;
    private string _description = string.Empty;
    private string _category = "Diğer";
    private string _accountIdValue = string.Empty;
    private int _installmentCount = 1;
    private bool _isInstallmentPurchase;
    private string _errorMessage = string.Empty;
    private bool _saving;
    private bool IsPayment => _category == "Kredi Kartı Ödemesi";
    private BankAccount? SelectedAccount => int.TryParse(_accountIdValue, out var id) ? _accounts.FirstOrDefault(account => account.Id == id) : null;
    private decimal Amount => TryAmount(_amountText, out var amount) ? amount : 0;
    private decimal PayableDebt => _card is null ? 0 : _card.StatementDebt + _card.CurrentPeriodDebt;
    private DateTime OpenPeriodLastDay => _card is null ? DateTime.Today : CardBilling.NextStatement(_card.LastStatementDate.Date, _card.StatementDay).AddDays(-1);
    private int EffectiveInstallmentCount => _isInstallmentPurchase ? _installmentCount : 1;

    protected override async Task OnParametersSetAsync()
    {
        await Database.InitializeAsync();
        _card = (await Database.GetCreditCardsAsync()).FirstOrDefault(card => card.Id == CardId && card.IsActive);
        _accounts = await Database.GetBankAccountsAsync();
        _recentTransactions = _card is null ? new() : await Database.GetRecentCardTransactionsAsync(_card.Id);
    }

    private string CardEffectHint()
    {
        if (_card is null) return string.Empty;
        var cutoff = CardBilling.StatementDate(_date, _card.StatementDay);
        return _isInstallmentPurchase
            ? $"Taksit tutarı × taksit sayısı hemen güncel borca eklenir ve kullanılabilir limitten düşer. İlk taksit {cutoff:dd.MM.yyyy} dönemine, kalan taksitler sonraki dönemlere yazılır."
            : $"Harcama {cutoff:dd.MM.yyyy} kesimli döneme ve güncel borca eklenir.";
    }

    private async Task AddTransactionAsync()
    {
        if (_saving) return;
        _errorMessage = ValidationError();
        if (_errorMessage.Length > 0 || _card is null) return;
        _saving = true;
        try
        {
            if (IsPayment)
            {
                await Database.PayCreditCardAsync(_card.Id, SelectedAccount!.Id, Amount, "Kredi kartı ödemesi");
                await WidgetSummary.TryRefreshAsync();
                try { await NotificationService.ScheduleDailyBalanceAsync(); } catch { }
            }
            else
            {
                await Database.AddTransactionAsync(new FinancialTransaction
                {
                    Date = _date, Type = TransactionType.Expense, Amount = Amount * EffectiveInstallmentCount,
                    Description = _description.Trim(), Category = _category,
                    CardId = _card.Id, Source = "Manual", InstallmentCount = EffectiveInstallmentCount
                });
                await WidgetSummary.TryRefreshAsync();
            }
            Navigation.NavigateTo("/");
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
            _card = (await Database.GetCreditCardsAsync()).FirstOrDefault(card => card.Id == CardId && card.IsActive);
            _accounts = await Database.GetBankAccountsAsync();
        }
        finally { _saving = false; }
    }

    private void SetPurchaseMode(bool installments)
    {
        _isInstallmentPurchase = installments;
        _installmentCount = installments ? 2 : 1;
        _errorMessage = string.Empty;
    }

    private string ValidationError()
    {
        if (_card is null) return "Kart bulunamadı.";
        if (!TryAmount(_amountText, out var amount) || amount <= 0 || decimal.Round(amount, 2) != amount)
            return "Sıfırdan büyük, en fazla iki ondalıklı bir tutar girin.";
        if (IsPayment)
        {
            if (SelectedAccount is null) return "Ödeme için banka hesabı seçin.";
            if (amount > SelectedAccount.CurrentBalance) return "Banka hesabı bakiyesi yetersiz.";
            if (amount > PayableDebt) return "Ödeme ödenebilir borcu aşamaz.";
            return string.Empty;
        }
        if (_date.Date < _card.LastStatementDate.Date || _date.Date > OpenPeriodLastDay)
            return "İşlem tarihi mevcut hesap döneminde olmalı.";
        if (string.IsNullOrWhiteSpace(_description)) return "Harcama açıklaması girin.";
        if (_isInstallmentPurchase && (_installmentCount is < 2 or > 36 || amount > decimal.MaxValue / _installmentCount))
            return "2-36 arasında geçerli bir taksit sayısı girin.";
        return string.Empty;
    }

    private static bool TryAmount(string value, out decimal amount) =>
        decimal.TryParse(value, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
            value.Contains(',') ? new CultureInfo("tr-TR") : CultureInfo.InvariantCulture, out amount);
    private static string Money(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);
}
