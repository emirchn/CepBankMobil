@page "/accounts"
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@using System.Globalization
@inject DatabaseService Database
@inject NotificationService NotificationService
@inject WidgetSummaryService WidgetSummary

<div class="finance-page accounts-page">
    <header class="finance-header card-list-header">
        <div><p class="eyebrow">CEPBANK / BANKA</p><h1>Hesaplar</h1><p class="header-subtitle">Banka bakiyelerini ayrı ayrı takip et.</p></div>
        <button type="button" class="header-action" @onclick="ShowAdd">+ Hesap ekle</button>
    </header>

    @if (_showForm)
    {
        <section class="add-card account-form">
            <div class="section-heading"><h2>@(_editingId.HasValue ? "Hesabı düzenle" : "Yeni banka hesabı")</h2><button type="button" class="delete-button" @onclick="CancelForm">Vazgeç</button></div>
            <div class="form-grid">
                <label>Hesap Adı<input @bind="_name" placeholder="Örn. Maaş hesabı" /></label>
                <label>IBAN<input @bind="_iban" inputmode="text" autocapitalize="characters" placeholder="TR..." /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }
            <button type="button" class="primary-button" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Kaydediliyor…" : "Hesabı kaydet")</button>
        </section>
    }

    @if (_accounts.Count == 0)
    {
        <div class="empty-state"><strong>Henüz banka hesabı yok</strong><p>Hesap adı ve IBAN ekleyerek bakiyeni takip etmeye başla.</p></div>
    }
    else
    {
        <div class="account-list">
            @foreach (var account in _accounts)
            {
                <article class="account-list-item" @key="account.Id">
                    <NavLink href="@($"accounts/{account.Id}")" class="account-list-link">
                        <span class="account-list-name">@account.Name</span>
                        <small>@FormatIban(account.Iban)</small>
                        <strong>@Money(account.CurrentBalance)</strong>
                    </NavLink>
                    <div class="account-list-controls">
                        <label class="account-home-choice"><input type="radio" name="home-account" checked="@account.ShowOnHome" @onchange="() => SelectHomeAsync(account.Id)" /> Ana Sayfada Göster</label>
                        <button type="button" class="section-link" @onclick="() => Edit(account)">Düzenle</button>
                    </div>
                </article>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_selectionError)) { <p class="error-message">@_selectionError</p> }
</div>

@code {
    private List<BankAccount> _accounts = new();
    private bool _showForm;
    private bool _saving;
    private int? _editingId;
    private string _name = string.Empty;
    private string _iban = string.Empty;
    private string _error = string.Empty;
    private string _selectionError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Database.InitializeAsync();
        await ReloadAsync();
    }

    private void ShowAdd() { _editingId = null; _name = _iban = _error = string.Empty; _showForm = true; }
    private void Edit(BankAccount account) { _editingId = account.Id; _name = account.Name; _iban = account.Iban; _error = string.Empty; _showForm = true; }
    private void CancelForm() => _showForm = false;
    private Task ReloadAsync() => LoadAsync();
    private async Task LoadAsync() => _accounts = await Database.GetBankAccountsAsync();

    private async Task SaveAsync()
    {
        _saving = true;
        _error = string.Empty;
        try
        {
            await Database.SaveBankAccountAsync(new BankAccount { Id = _editingId ?? 0, Name = _name, Iban = _iban });
            _showForm = false;
            await ReloadAsync();
            await WidgetSummary.TryRefreshAsync();
            try { await NotificationService.ScheduleDailyBalanceAsync(); } catch { }
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task SelectHomeAsync(int id)
    {
        _selectionError = string.Empty;
        try
        {
            await Database.SetHomeBankAccountAsync(id);
            await ReloadAsync();
            await WidgetSummary.TryRefreshAsync();
            try { await NotificationService.ScheduleDailyBalanceAsync(); } catch { }
        }
        catch (InvalidOperationException ex) { _selectionError = ex.Message; await ReloadAsync(); }
    }

    private static string Money(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);
    private static string FormatIban(string iban) => string.Join(" ", Enumerable.Range(0, (iban.Length + 3) / 4)
        .Select(index => iban.Substring(index * 4, Math.Min(4, iban.Length - index * 4))));
}
