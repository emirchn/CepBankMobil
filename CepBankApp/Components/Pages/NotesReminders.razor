@page "/notes/reminders"
@layout NotesLayout
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@inject NotesStore Store
@inject NotesReminderService Notifications

<section class="notes-page">
    <div class="notes-heading"><div><p class="notes-kicker">NOTLARIM</p><h1>Hatırlatıcı</h1></div><NavLink class="notes-primary" href="notes/reminders/new">+ Etkinlik ekle</NavLink></div>

    <div class="notes-panel calendar-panel">
        <div class="calendar-head"><button type="button" aria-label="Önceki ay" @onclick="() => ChangeMonth(-1)">‹</button><strong>@_month.ToString("MMMM yyyy", Turkish)</strong><button type="button" aria-label="Sonraki ay" @onclick="() => ChangeMonth(1)">›</button></div>
        <div class="calendar-grid">
            @foreach (var name in Weekdays) { <span class="calendar-weekday">@name</span> }
            @foreach (var date in CalendarDays())
            {
                if (date is null) { <span class="calendar-blank"></span> }
                else
                {
                    var day = date.Value;
                    var hasEvents = _items.Any(x => x.EventDate.Date == day);
                    <button type="button" class="calendar-day @(hasEvents ? "has-events" : "")" disabled="@(!hasEvents)" @onclick="() => OpenDay(day)" aria-label="@day.ToString("dd MMMM yyyy", Turkish)"><span>@day.Day</span>@if (hasEvents) { <i aria-hidden="true"></i> }</button>
                }
            }
        </div>
    </div>

    <div class="notes-toolbar"><input type="search" placeholder="Etkinlik ara" aria-label="Etkinlik ara" @bind="_search" @bind:event="oninput" /><select aria-label="Etkinlik filtresi" @bind="_filter"><option value="upcoming">Gelecek etkinlikler</option><option value="all">Tümü</option><option value="past">Geçmiş</option></select></div>
    <div class="notes-list">
        @foreach (var item in FilteredItems())
        {
            <article class="notes-panel reminder-row" @key="item.Id">
                <div class="reminder-date"><strong>@item.EventDate.Day</strong><small>@item.EventDate.ToString("MMM", Turkish)</small></div>
                <div class="reminder-info">
                    @if (_editingId == item.Id)
                    {
                        <input aria-label="Etkinlik adı" maxlength="120" @bind="_editName" />
                        <textarea aria-label="Açıklama" maxlength="1000" @bind="_editDescription"></textarea>
                        <div class="notes-actions"><button type="button" @onclick="() => SaveEditAsync(item)">Kaydet</button><button type="button" @onclick="CancelEdit">Vazgeç</button></div>
                    }
                    else
                    {
                        <strong>@item.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }
                        <small>@item.EventDate.ToString("dddd, dd MMMM yyyy", Turkish)</small>
                        <div class="notes-actions"><button type="button" @onclick="() => StartEdit(item)">Düzenle</button><button type="button" class="danger" @onclick="() => AskDelete(item.Id)">Sil</button></div>
                        @if (_deleteId == item.Id) { <div class="inline-confirm"><span>Etkinlik silinsin mi?</span><button type="button" @onclick="() => DeleteAsync(item)">Evet, sil</button><button type="button" @onclick="() => _deleteId = null">Vazgeç</button></div> }
                    }
                </div>
            </article>
        }
        @if (!FilteredItems().Any()) { <div class="notes-empty">Bu filtreye uygun etkinlik yok.</div> }
    </div>
    @if (!string.IsNullOrWhiteSpace(_message)) { <p class="notes-message">@_message</p> }
</section>

@if (_selectedDay is not null)
{
    <div class="notes-modal-backdrop" role="presentation" @onclick="CloseDay">
        <div class="notes-modal" role="dialog" aria-modal="true" aria-label="Günün etkinlikleri" @onclick:stopPropagation="true">
            <div class="notes-heading"><h2>@_selectedDay.Value.ToString("dd MMMM yyyy", Turkish)</h2><button type="button" @onclick="CloseDay" aria-label="Kapat">✕</button></div>
            @foreach (var item in _items.Where(x => x.EventDate.Date == _selectedDay.Value)) { <div class="modal-event"><strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }</div> }
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Turkish = new("tr-TR");
    private static readonly string[] Weekdays = ["Pt", "Sa", "Ça", "Pe", "Cu", "Ct", "Pa"];
    private List<NoteReminder> _items = [];
    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _selectedDay;
    private string _search = "";
    private string _filter = "upcoming";
    private int? _editingId, _deleteId;
    private string _editName = "", _editDescription = "", _message = "";
    protected override async Task OnInitializedAsync() => _items = await Store.GetRemindersAsync();
    private IEnumerable<DateTime?> CalendarDays()
    {
        var lead = ((int)_month.DayOfWeek + 6) % 7;
        for (var i = 0; i < lead; i++) yield return null;
        for (var day = 1; day <= DateTime.DaysInMonth(_month.Year, _month.Month); day++) yield return _month.AddDays(day - 1);
    }
    private void ChangeMonth(int offset) => _month = _month.AddMonths(offset);
    private void OpenDay(DateTime day) => _selectedDay = day;
    private void CloseDay() => _selectedDay = null;
    private IEnumerable<NoteReminder> FilteredItems() => _items.Where(x =>
        (_filter == "all" || (_filter == "past" ? x.EventDate.Date < DateTime.Today : x.EventDate.Date >= DateTime.Today)) &&
        (string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase) || x.Description.Contains(_search, StringComparison.CurrentCultureIgnoreCase)));
    private void StartEdit(NoteReminder item) { _editingId = item.Id; _editName = item.Name; _editDescription = item.Description; _deleteId = null; }
    private void CancelEdit() => _editingId = null;
    private async Task SaveEditAsync(NoteReminder item)
    {
        if (string.IsNullOrWhiteSpace(_editName)) { _message = "Etkinlik adı gerekli."; return; }
        item.Name = _editName.Trim(); item.Description = _editDescription.Trim();
        await Store.SaveReminderAsync(item); await Notifications.RefreshAsync(); _editingId = null; _message = "Etkinlik güncellendi.";
    }
    private void AskDelete(int id) => _deleteId = id;
    private async Task DeleteAsync(NoteReminder item)
    {
        await Store.DeleteReminderAsync(item); _items.Remove(item); await Notifications.RefreshAsync(); _deleteId = null;
    }
}
