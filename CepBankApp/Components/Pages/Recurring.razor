@page "/recurring"
@using CepBankApp.Data
@using CepBankApp.Models
@using CepBankApp.Services
@using System.Globalization
@inject DatabaseService Database
@inject RecurringTransactionService RecurringService
@inject WidgetSummaryService WidgetSummary
@inject NotificationService NotificationService

<div class="finance-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / ABONELİKLER</p><h1>Abonelik İşlemleri</h1><p class="header-subtitle">Dijital aboneliklerini kartına bağla.</p></div>
    </header>
    <section class="add-card">
        <div class="section-heading"><h2>Yeni abonelik</h2><span>Her ay karttan işlenir</span></div>
        <div class="form-grid">
            <label>Abonelik adı<input @bind="_name" placeholder="Örn. Netflix" /></label>
            <label>Aylık tutar (TL)<input type="number" min="0.01" step="0.01" @bind="_amountText" placeholder="0,00" /></label>
            <label>Başlangıç<input type="date" @bind="_startDate" /></label>
            <label>Bitiş (isteğe bağlı)<input type="date" @bind="_endDate" /></label>
            <label>Kredi kartı
                <select @bind="_cardId">
                    <option value="">Kart seç</option>
                    @foreach (var card in _cards)
                    {
                        <option value="@card.Id">@card.Name •••• @card.LastFourDigits</option>
                    }
                </select>
            </label>
        </div>
        <p class="field-hint">Ödeme günü geldiğinde aylık tutar seçili kartın harcaması olarak kaydedilir. Bitiş tarihi boşsa abonelik sürer.</p>
        @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }
        <button class="primary-button" type="button" @onclick="AddAsync">Aboneliği kaydet</button>
    </section>
    <section class="transactions-section">
        <div class="section-heading"><h2>Kayıtlı abonelikler</h2><span>@_items.Count kayıt</span></div>
        @if (_items.Count == 0)
        {
            <div class="empty-state"><strong>Henüz abonelik yok</strong><p>Dijital aboneliğini ekleyebilirsin.</p></div>
        }
        else
        {
            <div class="transaction-list">
                @foreach (var item in _items)
                {
                    <article class="transaction-row" @key="item.Id">
                        <div class="transaction-icon expense">↗</div>
                        <div class="transaction-details">
                            <strong>@item.Name</strong>
                            <span>@CardName(item.CardId) · Her ay @item.DayOfMonth. gün</span>
                            <span>Başlangıç: @item.StartDate.ToString("dd.MM.yyyy") · Bitiş: @(item.EndDate?.ToString("dd.MM.yyyy") ?? "Süresiz")</span>
                        </div>
                        <div class="transaction-actions">
                            <strong class="negative">−@Money(item.Amount)</strong>
                            @if (_confirmDeleteId == item.Id)
                            {
                                <div class="recurring-delete-actions"><button class="delete-button confirm-delete" @onclick="() => DeleteAsync(item)">Evet, sil</button><button class="delete-button" @onclick="() => _confirmDeleteId = null">Vazgeç</button></div>
                            }
                            else
                            {
                                <button class="delete-button" @onclick="() => _confirmDeleteId = item.Id">Sil</button>
                            }
                        </div>
                    </article>
                }
            </div>
            <div class="subscription-totals" aria-label="Kartlara göre aylık abonelik toplamı">
                @foreach (var group in _items.GroupBy(item => item.CardId).OrderBy(group => CardName(group.Key)))
                {
                    <div><span>@CardName(group.Key)</span><strong>@Money(group.Sum(item => item.Amount))</strong></div>
                }
                <div class="subscription-grand-total"><span>Aylık Toplam</span><strong>@Money(_items.Sum(item => item.Amount))</strong></div>
            </div>
        }
    </section>
</div>

@code {
    private List<RecurringItem> _items = new();
    private List<CreditCard> _cards = new();
    private string _name = string.Empty;
    private string _amountText = string.Empty;
    private DateTime _startDate = DateTime.Today;
    private DateTime? _endDate;
    private int? _cardId;
    private int? _confirmDeleteId;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Database.InitializeAsync();
        await RecurringService.ProcessAsync();
        await ReloadAsync();
    }

    private async Task AddAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Abonelik adı girin."; return; }
        if (_endDate.HasValue && _endDate.Value.Date < _startDate.Date) { _error = "Bitiş tarihi başlangıçtan önce olamaz."; return; }
        if (_cardId is null || !_cards.Any(card => card.Id == _cardId)) { _error = "Kredi kartı seçin."; return; }
        if (!decimal.TryParse(_amountText, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount))
            decimal.TryParse(_amountText, NumberStyles.Number, new CultureInfo("tr-TR"), out amount);
        if (amount <= 0 || decimal.Round(amount, 2) != amount) { _error = "Geçerli bir aylık tutar girin."; return; }
        await Database.AddRecurringItemAsync(new RecurringItem
        {
            Name = _name.Trim(), Amount = amount, TransactionType = TransactionType.Expense,
            RecurringType = RecurringType.Subscription, Category = "Abonelik",
            CardId = _cardId, DayOfMonth = _startDate.Day,
            StartDate = _startDate.Date, EndDate = _endDate?.Date
        });
        await RecurringService.ProcessAsync(force: true);
        await WidgetSummary.TryRefreshAsync();
        try { await NotificationService.ScheduleUpcomingPaymentsAsync(); } catch { }
        _name = _amountText = string.Empty;
        _endDate = null;
        _cardId = null;
        await ReloadAsync();
    }

    private async Task DeleteAsync(RecurringItem item)
    {
        _confirmDeleteId = null;
        await Database.DeleteRecurringItemAsync(item);
        await WidgetSummary.TryRefreshAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = (await Database.GetRecurringItemsAsync())
            .Where(item => item.RecurringType == RecurringType.Subscription && item.CardId.HasValue).ToList();
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
    }

    private string CardName(int? cardId) => _cards.FirstOrDefault(card => card.Id == cardId)?.Name ?? "Kart kaldırıldı";
    private static string Money(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);
}
