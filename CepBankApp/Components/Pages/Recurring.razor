@page "/recurring"
@using CepBankApp.Data
@using CepBankApp.Models
@using System.Globalization
@using CepBankApp.Services
@inject DatabaseService Database
@inject CepBankApp.Services.RecurringTransactionService RecurringService
@inject NotificationService NotificationService

<div class="finance-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / DÜZENLİ</p><h1>Düzenli işlemler</h1><p class="header-subtitle">Düzenli gelir ve ödemelerin burada.</p></div>
    </header>

    <section class="add-card">
        <div class="section-heading"><h2>Yeni düzenli işlem</h2><span>Her ay otomatik kaydedilir</span></div>
        <div class="form-grid">
            <label>İşlem adı
                <input @bind="_name" placeholder="Örn. Maaş, Netflix, Kredi" />
            </label>
            <label>Tutar
                <input type="number" step="0.01" @bind="_amountText" placeholder="0,00" />
            </label>
            <TypeToggle @bind-Value="TypeValue" />
            <label>Kategori
                <select @bind="_category">
                    @if (TypeValue == "Income")
                    {
                        <option>Maaş</option>
                        <option>Kira</option>
                        <option>Diğer Gelir</option>
                    }
                    else
                    {
                        <option>Kredi Ödemesi</option>
                        <option>Fatura</option>
                        <option>Dijital Abonelik</option>
                        <option>Alışveriş Taksidi</option>
                        <option>Diğer Giderler</option>
                    }
                </select>
            </label>
            <div class="recurring-dates">
                <label>Başlangıç
                    <input type="date" @bind="_startDate" />
                </label>
                <label>Bitiş (isteğe bağlı)
                    <input type="date" @bind="_endDate" />
                </label>
            </div>
            @if (TypeValue == "Expense" && _category == "Kredi Ödemesi")
            {
                <label>Kalan taksit (isteğe bağlı)
                    <input type="number" min="1" @bind="_installments" />
                </label>
                <div class="loan-reminder-field">
                    <strong>Ödeme bildirimi</strong>
                    <div class="notification-options" role="group" aria-label="Kredi ödemesi bildirim günleri">
                        @foreach (var day in NotificationSettings.ReminderDays)
                        {
                            <button type="button" class="@ReminderClass(_loanReminderDaysMask, day)" aria-pressed="@NotificationSettings.HasDay(_loanReminderDaysMask, day)" @onclick="() => ToggleNewLoanReminder(day)">@day gün önce</button>
                        }
                    </div>
                </div>
            }
            @if (TypeValue == "Expense")
            {
                <label>Kart (isteğe bağlı)
                    <select @bind="_cardId">
                        <option value="">Kart seçme</option>
                        @foreach (var card in _cards)
                        {
                            <option value="@card.Id">@card.Name •••• @card.LastFourDigits</option>
                        }
                    </select>
                </label>
            }
        </div>
        @if (TypeValue == "Expense" && _cardId.HasValue)
        {
            <p class="field-hint">Beklenen gider seçilen kartla gösterilir; işlem günü geldiğinde tutar kartın borcuna ve ilgili kesim dönemine eklenir.</p>
        }
        <p class="field-hint">Her ay başlangıç tarihinin gününde eklenir. Bitiş seçilmezse bir yıl sonra sona erer.</p>
        @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }
        @if (!string.IsNullOrWhiteSpace(_notificationWarning)) { <p class="field-hint">@_notificationWarning</p> }
        <button class="primary-button" @onclick="AddAsync">Düzenli işlemi kaydet</button>
    </section>

    <section class="transactions-section">
        <div class="section-heading"><h2>Kayıtlı işlemler</h2><span>@_items.Count kayıt</span></div>
        @if (!_items.Any())
        {
            <div class="empty-state"><strong>Düzenli işlem yok</strong><p>Maaş veya abonelik ekleyebilirsin.</p></div>
        }
        else
        {
            <div class="transaction-list">
                @foreach (var item in _items)
                {
                    var income = item.TransactionType == TransactionType.Income;
                    <article class="transaction-row" @key="item.Id">
                        <div class="transaction-icon @(income ? "income" : "expense")">@(income ? "↗" : "↘")</div>
                        <div class="transaction-details"><strong>@item.Name</strong><span>@item.Category • Her ay @item.DayOfMonth. gün</span></div>
                        <div class="transaction-actions">
                            <strong class="@(income ? "positive" : "negative")">@FormatMoney(item.Amount)</strong>
                            @if (_confirmDeleteId == item.Id)
                            {
                                <div class="recurring-delete-actions"><button class="delete-button confirm-delete" @onclick="() => ConfirmDeleteAsync(item)">Evet, sil</button><button class="delete-button" @onclick="CancelDelete">Vazgeç</button></div>
                            }
                            else
                            {
                                <button class="delete-button" @onclick="() => RequestDelete(item)">Sil</button>
                            }
                        </div>
                        @if (item.TransactionType == TransactionType.Expense && item.Category == "Kredi Ödemesi")
                        {
                            <div class="loan-reminder-row">
                                <span>Ödeme bildirimi</span>
                                <div class="notification-options" role="group" aria-label="@item.Name için bildirim günleri">
                                    @foreach (var day in NotificationSettings.ReminderDays)
                                    {
                                        <button type="button" class="@ReminderClass(item.LoanReminderDaysMask, day)" aria-pressed="@NotificationSettings.HasDay(item.LoanReminderDaysMask, day)" @onclick="() => ToggleSavedLoanReminderAsync(item, day)">@day gün</button>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<RecurringItem> _items = new();
    private List<CreditCard> _cards = new();
    private int? _cardId;
    private string _name = string.Empty;
    private string _amountText = string.Empty;
    private string _typeValue = "Expense";
    private string TypeValue
    {
        get => _typeValue;
        set
        {
            if (_typeValue == value) return;
            _typeValue = value;
            _category = value == "Income" ? "Maaş" : "Fatura";
            if (value == "Income") _cardId = null;
        }
    }
    private DateTime _startDate = DateTime.Today;
    private DateTime? _endDate;
    private int? _installments;
    private string _category = "Fatura";
    private string _error = string.Empty;
    private string _notificationWarning = string.Empty;
    private int? _confirmDeleteId;
    private int _loanReminderDaysMask;
    private static string ReminderClass(int mask, int day) => NotificationSettings.HasDay(mask, day) ? "notification-option selected" : "notification-option";
    private void ToggleNewLoanReminder(int day) => _loanReminderDaysMask = NotificationSettings.ToggleDay(_loanReminderDaysMask, day);

    private async Task ToggleSavedLoanReminderAsync(RecurringItem item, int day)
    {
        item.LoanReminderDaysMask = NotificationSettings.ToggleDay(item.LoanReminderDaysMask, day);
        await Database.UpdateRecurringItemAsync(item);
        try { await NotificationService.ScheduleUpcomingPaymentsAsync(); }
        catch { _notificationWarning = "Bildirim zamanı kaydedildi; bildirimler sonraki açılışta tekrar planlanacak."; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Database.InitializeAsync();
        await RecurringService.ProcessAsync();
        await ReloadAsync();
    }

    private async Task AddAsync()
    {
        _error = string.Empty;
        _notificationWarning = string.Empty;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "İşlem adı girin."; return; }
        if (_endDate.HasValue && _endDate.Value.Date < _startDate.Date)
        { _error = "Bitiş tarihi başlangıçtan önce olamaz."; return; }
        if (!decimal.TryParse(_amountText, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount))
            decimal.TryParse(_amountText, NumberStyles.Number, new CultureInfo("tr-TR"), out amount);
        if (amount <= 0) { _error = "Tutar sıfırdan büyük olmalıdır."; return; }
        if (TypeValue == "Expense" && _category == "Kredi Ödemesi" && _installments is <= 0)
        { _error = "Taksit sayısını boş bırakın veya sıfırdan büyük bir değer girin."; return; }

        var type = _category switch
        {
            "Maaş" => RecurringType.Salary,
            "Kira" or "Diğer Gelir" => RecurringType.Income,
            "Kredi Ödemesi" => RecurringType.Loan,
            "Dijital Abonelik" => RecurringType.Subscription,
            _ => RecurringType.OtherExpense
        };

        await Database.AddRecurringItemAsync(new RecurringItem
        {
            Name = _name.Trim(),
            Amount = amount,
            TransactionType = TypeValue == "Income" ? TransactionType.Income : TransactionType.Expense,
            RecurringType = type,
            DayOfMonth = _startDate.Day,
            StartDate = _startDate,
            EndDate = _endDate ?? _startDate.AddYears(1),
            Category = _category,
            CardId = TypeValue == "Expense" ? _cardId : null,
            RemainingInstallments = type == RecurringType.Loan ? _installments ?? 0 : 0,
            LoanReminderDaysMask = type == RecurringType.Loan ? _loanReminderDaysMask : 0
        });

        await RecurringService.ProcessAsync(force: true);
        try
        {
            await NotificationService.ScheduleUpcomingPaymentsAsync();
            await NotificationService.CheckMonthlyBalanceAsync();
        }
        catch { _notificationWarning = "Kayıt eklendi; bildirimler sonraki açılışta tekrar planlanacak."; }
        _name = _amountText = string.Empty;
        _cardId = null;
        _loanReminderDaysMask = 0;
        await ReloadAsync();
    }

    private void RequestDelete(RecurringItem item) => _confirmDeleteId = item.Id;

    private void CancelDelete() => _confirmDeleteId = null;

    private async Task ConfirmDeleteAsync(RecurringItem item)
    {
        _confirmDeleteId = null;
        await Database.DeleteRecurringItemAsync(item);
        try { await NotificationService.ScheduleUpcomingPaymentsAsync(); }
        catch { _notificationWarning = "Kayıt silindi; bildirimler sonraki açılışta tekrar planlanacak."; }
        await ReloadAsync();
    }

    private async Task DeleteAsync(RecurringItem item)
    {
        await Database.DeleteRecurringItemAsync(item);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await Database.GetRecurringItemsAsync();
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
    }

    private static string FormatMoney(decimal amount) => string.Format(new CultureInfo("tr-TR"), "{0:C2}", amount);
}
