@page "/settings"
@using CepBankApp.Data
@using Microsoft.Maui.ApplicationModel.DataTransfer
@using Microsoft.Maui.Storage
@using Plugin.LocalNotification
@using Plugin.LocalNotification.Core.Models
@using CepBankApp.Services
@inject DatabaseService Database
@inject NotificationService NotificationService
@inject WidgetSummaryService WidgetSummary
@inject IJSRuntime JS

<div class="finance-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / UYGULAMA</p><h1>Ayarlar</h1><p class="header-subtitle">Verilerin ve uygulama tercihlerin.</p></div>
    </header>

    <section class="transactions-section">
        <div class="section-heading"><h2>Yerel veriler</h2><span>Bu cihazda saklanır</span></div>
        <p class="settings-copy">Gelir, gider, aylık tekrarlanan işlemler ve kartlar yalnızca telefonunuzdaki yerel veritabanında tutulur.</p>
        <button class="primary-button" @onclick="ExportAsync">Verileri yedek olarak dışa aktar</button>
        @if (!string.IsNullOrWhiteSpace(_message)) { <p class="settings-message">@_message</p> }
    </section>

    <section class="transactions-section">
        <div class="section-heading"><div><p class="section-kicker">GÖRÜNÜM</p><h2>Tema</h2></div></div>
        <p class="settings-copy">Uygulamanın renklerini seç.</p>
        <div class="theme-options" role="group" aria-label="Tema seçimi">
            <button type="button" class="@ThemeClass("light")" aria-pressed="@(_themeMode == "light")" @onclick="SelectLightAsync">Gündüz</button>
            <button type="button" class="@ThemeClass("dark")" aria-pressed="@(_themeMode == "dark")" @onclick="SelectDarkAsync">Gece</button>
            <button type="button" class="@ThemeClass("device")" aria-pressed="@(_themeMode == "device")" @onclick="SelectDeviceAsync">Cihaz</button>
            <button type="button" class="@ThemeClass("glassy")" aria-pressed="@(_themeMode == "glassy")" @onclick="SelectGlassyAsync">Glassy</button>
        </div>
    </section>

    <section class="transactions-section notification-settings">
        <div class="section-heading"><h2>Bildirimler</h2></div>
        <p class="settings-copy">İstediğin uyarı zamanlarının hepsini seçebilirsin.</p>
        <div class="notification-setting-group">
            <strong>Hesap kesiminden önce</strong>
            <div class="notification-options" role="group" aria-label="Hesap kesim bildirim günleri">
                @foreach (var day in NotificationSettings.ReminderDays)
                {
                    <button type="button" class="@NotificationOptionClass(NotificationSettings.HasDay(_statementDays, day))" aria-pressed="@NotificationSettings.HasDay(_statementDays, day)" @onclick="() => ToggleStatementAsync(day)">@day gün</button>
                }
            </div>
        </div>
        <div class="notification-setting-group">
            <strong>Son ödeme tarihinden önce</strong>
            <div class="notification-options" role="group" aria-label="Son ödeme bildirim günleri">
                @foreach (var day in NotificationSettings.ReminderDays)
                {
                    <button type="button" class="@NotificationOptionClass(NotificationSettings.HasDay(_paymentDays, day))" aria-pressed="@NotificationSettings.HasDay(_paymentDays, day)" @onclick="() => TogglePaymentAsync(day)">@day gün</button>
                }
            </div>
        </div>
        <div class="notification-setting-group">
            <strong>Aylık gelirin harcanan oranı</strong>
            <div class="notification-options" role="group" aria-label="Aylık harcama bildirim eşikleri">
                @foreach (var percent in NotificationSettings.BalancePercents)
                {
                    <button type="button" class="@NotificationOptionClass(NotificationSettings.HasThreshold(_balanceThresholds, percent))" aria-pressed="@NotificationSettings.HasThreshold(_balanceThresholds, percent)" @onclick="() => ToggleThresholdAsync(percent)">%@percent</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_notificationMessage)) { <p class="settings-message">@_notificationMessage</p> }
    </section>

    <section class="transactions-section danger-section">
        <div class="section-heading"><div><p class="section-kicker">VERİ YÖNETİMİ</p><h2>Tüm verileri sıfırla</h2></div></div>
        <p class="settings-copy">Kayıtlı işlemler, aylık tekrarlanan işlemler ve kartlar silinir.</p>
        @if (!_showResetConfirm)
        {
            <button type="button" class="danger-button" @onclick="ShowResetConfirm">Tüm verileri sıfırla</button>
        }
        else
        {
            <div class="reset-confirm" role="alert">
                <strong>Bu işlem geri alınamaz.</strong>
                <p>Devam etmeden önce istersen yukarıdan yedek al.</p>
                <div class="reset-actions">
                    <button type="button" class="secondary-button" @onclick="CancelReset">Vazgeç</button>
                    <button type="button" class="danger-button" @onclick="ClearAllAsync">Evet, tüm verileri sil</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_resetMessage)) { <p class="settings-message">@_resetMessage</p> }
    </section>
</div>

@code {
    private string _message = string.Empty;
    private string _resetMessage = string.Empty;
    private string _themeMode = "device";
    private bool _showResetConfirm;
    private int _statementDays;
    private int _paymentDays;
    private int _balanceThresholds;
    private string _notificationMessage = string.Empty;

    protected override void OnInitialized()
    {
        _themeMode = Preferences.Default.Get("theme_mode", "device");
        _statementDays = NotificationSettings.StatementDays;
        _paymentDays = NotificationSettings.PaymentDays;
        _balanceThresholds = NotificationSettings.BalanceThresholds;
    }

    private static string NotificationOptionClass(bool selected) => selected ? "notification-option selected" : "notification-option";
    private Task ToggleStatementAsync(int day) { _statementDays = NotificationSettings.ToggleDay(_statementDays, day); NotificationSettings.StatementDays = _statementDays; return RefreshNotificationsAsync(); }
    private Task TogglePaymentAsync(int day) { _paymentDays = NotificationSettings.ToggleDay(_paymentDays, day); NotificationSettings.PaymentDays = _paymentDays; return RefreshNotificationsAsync(); }
    private Task ToggleThresholdAsync(int percent) { _balanceThresholds = NotificationSettings.ToggleThreshold(_balanceThresholds, percent); NotificationSettings.BalanceThresholds = _balanceThresholds; return RefreshNotificationsAsync(); }

    private async Task RefreshNotificationsAsync()
    {
        _notificationMessage = string.Empty;
        try
        {
            await NotificationService.RequestPermissionAsync();
            if (!await LocalNotificationCenter.Current.AreNotificationsEnabled(new NotificationPermission { AskPermission = false }))
            { _notificationMessage = "Bildirim izni kapalı. Cihaz ayarlarından CepBank bildirimlerine izin verin."; return; }
            await NotificationService.ScheduleUpcomingPaymentsAsync();
            await NotificationService.CheckMonthlyBalanceAsync();
        }
        catch (Exception ex) { _notificationMessage = $"Bildirimler güncellenemedi: {ex.Message}"; }
    }

    private string ThemeClass(string mode) => _themeMode == mode ? "theme-option active" : "theme-option";
    private Task SelectLightAsync() => SetThemeAsync("light");
    private Task SelectDarkAsync() => SetThemeAsync("dark");
    private Task SelectDeviceAsync() => SetThemeAsync("device");
    private Task SelectGlassyAsync() => SetThemeAsync("glassy");

    private async Task SetThemeAsync(string mode)
    {
        _themeMode = mode;
        Preferences.Default.Set("theme_mode", mode);
        await CepBankApp.Services.AppAppearance.ApplyAsync(mode);
        await JS.InvokeVoidAsync("cepbankTheme.apply", mode);
    }

    private void ShowResetConfirm()
    {
        _resetMessage = string.Empty;
        _showResetConfirm = true;
    }

    private void CancelReset() => _showResetConfirm = false;

    private async Task ClearAllAsync()
    {
        try
        {
            await Database.InitializeAsync();
            await Database.ClearAllDataAsync();
            await WidgetSummary.TryRefreshAsync();
            SecureStorage.Default.RemoveAll();
            LocalNotificationCenter.Current.CancelAll();
            NotificationService.ResetCurrentBalanceAlerts();
            _statementDays = NotificationSettings.StatementDays = 1 << 3;
            _paymentDays = NotificationSettings.PaymentDays = 1 << 3;
            _balanceThresholds = NotificationSettings.BalanceThresholds = 1 << 1;
            await SetThemeAsync("device");
            _showResetConfirm = false;
            _resetMessage = "Tüm veriler silindi.";
        }
        catch (Exception ex)
        {
            _resetMessage = $"Veriler silinemedi: {ex.Message}";
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            await Database.InitializeAsync();
            var path = Path.Combine(FileSystem.CacheDirectory, $"cepbank-yedek-{DateTime.Now:yyyyMMdd-HHmm}.json");
            await Database.ExportJsonAsync(path);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "CepBank yedeği",
                File = new ShareFile(path)
            });

            _message = "Yedek dosyası paylaşım menüsüne hazırlandı.";
        }
        catch (Exception ex)
        {
            _message = $"Yedek oluşturulamadı: {ex.Message}";
        }
    }
}
