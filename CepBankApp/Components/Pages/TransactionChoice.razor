@page "/transaction"

<div class="finance-page transaction-choice-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / YENİ KAYIT</p><h1>Yeni İşlem</h1><p class="header-subtitle">Eklemek istediğin işlem türünü seç.</p></div>
    </header>
    <nav class="transaction-choice-grid" aria-label="İşlem türü">
        <NavLink href="transaction/standard" class="transaction-tile tile-standard">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></svg></span>
            <span class="transaction-tile-copy"><strong>Standart İşlem</strong><small>Gelir veya gider ekle</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="recurring" class="transaction-tile tile-recurring">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 15h8"/></svg></span>
            <span class="transaction-tile-copy"><strong>Aylık Tekrarlanan İşlemler</strong><small>Maaş, fatura ve abonelikler</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=meal" class="transaction-tile tile-meal">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M7 15h4"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yemek Kartı İşlemleri</strong><small>Bakiye ve harcamalar</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=fuel" class="transaction-tile tile-fuel">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M3 21h16M7 7h8v5H7zM17 8h2l2 3v7a2 2 0 0 1-4 0"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yakıt Kartı İşlemleri</strong><small>Yakıt ve kart hareketleri</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
    </nav>
</div>
