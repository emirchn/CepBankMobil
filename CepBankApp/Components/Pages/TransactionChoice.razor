@page "/transaction"
@using CepBankApp.Data
@using CepBankApp.Models
@inject DatabaseService Database
@inject NavigationManager Navigation

<div class="finance-page transaction-choice-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / İŞLEMLER</p><h1>İşlemler</h1></div>
    </header>
    <nav class="transaction-choice-grid" aria-label="İşlem türü">
        <button type="button" class="transaction-tile tile-standard" @onclick="OpenCardPicker">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
            <span class="transaction-tile-copy"><strong>Kredi Kartları</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </button>
        <NavLink href="accounts" class="transaction-tile tile-account">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M7 15h5"/></svg></span>
            <span class="transaction-tile-copy"><strong>Hesaplar</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="recurring" class="transaction-tile tile-recurring">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 15h8"/></svg></span>
            <span class="transaction-tile-copy"><strong>Abonelikler</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="loans" class="transaction-tile tile-loan">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 8h18M5 8V5l7-3 7 3v3M6 8v11m4-11v11m4-11v11m4-11v11M3 21h18"/></svg></span>
            <span class="transaction-tile-copy"><strong>Krediler</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=meal" class="transaction-tile tile-meal">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M7 15h4"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yemek Kartı</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=fuel" class="transaction-tile tile-fuel">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M3 21h16M7 7h8v5H7zM17 8h2l2 3v7a2 2 0 0 1-4 0"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yakıt Kartı</strong></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
    </nav>

    @if (_showCardPicker)
    {
        <div class="dialog-backdrop" @onclick="CloseCardPicker">
            <section class="choice-dialog" role="dialog" aria-modal="true" aria-label="Kredi kartı seç" @onclick:stopPropagation="true">
                <div class="section-heading"><h2>Kredi kartı seç</h2><button type="button" class="delete-button" @onclick="CloseCardPicker">Kapat</button></div>
                @if (_cards.Count == 0)
                {
                    <p class="settings-copy">Önce bir kredi kartı ekle.</p>
                    <NavLink href="cards/new" class="inline-link">Kart ekle →</NavLink>
                }
                else
                {
                    <div class="choice-card-list">
                        @foreach (var card in _cards)
                        {
                            <button type="button" class="choice-card-option" @onclick="() => SelectCard(card.Id)"><span>@card.Name</span><small>•••• @card.LastFourDigits</small><span aria-hidden="true">→</span></button>
                        }
                    </div>
                }
            </section>
        </div>
    }

</div>

@code {
    private bool _showCardPicker;
    private List<CreditCard> _cards = new();

    private async Task OpenCardPicker()
    {
        await Database.InitializeAsync();
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
        _showCardPicker = true;
    }

    private void CloseCardPicker() => _showCardPicker = false;
    private void SelectCard(int id) => Navigation.NavigateTo($"transaction/standard/{id}");
}
