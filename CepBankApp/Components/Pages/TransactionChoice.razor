@page "/transaction"
@using CepBankApp.Data
@using CepBankApp.Models
@inject DatabaseService Database
@inject NavigationManager Navigation

<div class="finance-page transaction-choice-page">
    <header class="finance-header">
        <div><p class="eyebrow">CEPBANK / YENİ KAYIT</p><h1>Yeni İşlem</h1><p class="header-subtitle">İşlem yapmak istediğin alanı seç.</p></div>
    </header>
    <nav class="transaction-choice-grid" aria-label="İşlem türü">
        <button type="button" class="transaction-tile tile-standard" @onclick="OpenCardPicker">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
            <span class="transaction-tile-copy"><strong>Kredi Kartı İşlemi</strong><small>Kart seçip gider ekle</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </button>
        <button type="button" class="transaction-tile tile-account" @onclick="OpenAccountPicker">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M7 15h5"/></svg></span>
            <span class="transaction-tile-copy"><strong>Hesap İşlemi</strong><small>Hesap seçip bakiye veya harcama kaydet</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </button>
        <NavLink href="recurring" class="transaction-tile tile-recurring">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 15h8"/></svg></span>
            <span class="transaction-tile-copy"><strong>Aylık Tekrarlanan İşlemler</strong><small>Düzenli giderler</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=meal" class="transaction-tile tile-meal">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M7 15h4"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yemek Kartı İşlemleri</strong><small>Bakiye ve harcamalar</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
        <NavLink href="cards?type=fuel" class="transaction-tile tile-fuel">
            <span class="transaction-tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M3 21h16M7 7h8v5H7zM17 8h2l2 3v7a2 2 0 0 1-4 0"/></svg></span>
            <span class="transaction-tile-copy"><strong>Yakıt Kartı İşlemleri</strong><small>Yakıt ve kart hareketleri</small></span><span class="transaction-tile-arrow" aria-hidden="true">↗</span>
        </NavLink>
    </nav>

    @if (_showCardPicker)
    {
        <div class="dialog-backdrop" @onclick="CloseCardPicker">
            <section class="choice-dialog" role="dialog" aria-modal="true" aria-label="Kredi kartı seç" @onclick:stopPropagation="true">
                <div class="section-heading"><h2>Kredi kartı seç</h2><button type="button" class="delete-button" @onclick="CloseCardPicker">Kapat</button></div>
                @if (_cards.Count == 0)
                {
                    <p class="settings-copy">Önce bir kredi kartı ekle.</p>
                    <NavLink href="cards/new" class="inline-link">Kart ekle →</NavLink>
                }
                else
                {
                    <div class="choice-card-list">
                        @foreach (var card in _cards)
                        {
                            <button type="button" class="choice-card-option" @onclick="() => SelectCard(card.Id)"><span>@card.Name</span><small>•••• @card.LastFourDigits</small><span aria-hidden="true">→</span></button>
                        }
                    </div>
                }
            </section>
        </div>
    }
    @if (_showAccountPicker)
    {
        <div class="dialog-backdrop" @onclick="CloseAccountPicker">
            <section class="choice-dialog" role="dialog" aria-modal="true" aria-label="Banka hesabı seç" @onclick:stopPropagation="true">
                <div class="section-heading"><h2>Banka hesabı seç</h2><button type="button" class="delete-button" @onclick="CloseAccountPicker">Kapat</button></div>
                @if (_accounts.Count == 0)
                {
                    <p class="settings-copy">Önce bir banka hesabı ekle.</p>
                    <NavLink href="accounts" class="inline-link">Hesap ekle →</NavLink>
                }
                else
                {
                    <div class="choice-card-list">
                        @foreach (var account in _accounts)
                        {
                            <button type="button" class="choice-card-option" @onclick="() => SelectAccount(account.Id)"><span>@account.Name</span><small>@Money(account.CurrentBalance)</small><span aria-hidden="true">→</span></button>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private bool _showCardPicker;
    private bool _showAccountPicker;
    private List<CreditCard> _cards = new();
    private List<BankAccount> _accounts = new();

    private async Task OpenCardPicker()
    {
        await Database.InitializeAsync();
        _cards = (await Database.GetCreditCardsAsync()).Where(card => card.IsActive).ToList();
        _showCardPicker = true;
    }

    private void CloseCardPicker() => _showCardPicker = false;
    private void SelectCard(int id) => Navigation.NavigateTo($"transaction/standard/{id}");
    private async Task OpenAccountPicker()
    {
        await Database.InitializeAsync();
        _accounts = await Database.GetBankAccountsAsync();
        _showAccountPicker = true;
    }
    private void CloseAccountPicker() => _showAccountPicker = false;
    private void SelectAccount(int id) => Navigation.NavigateTo($"accounts/{id}");
    private static string Money(decimal amount) => string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:C2}", amount);
}
